# Configuration npm versionnée — DEP-02 (audit 2026-06-02)
# Registre par défaut explicite (évite l'override silencieux via registre tiers la plateforme initiale).
registry=https://registry.npmjs.org/

# Reproductibilité : refuser un lockfile incohérent en CI.
engine-strict=true
save-exact=false
fund=false
audit=false

# Sécurité : pas d'exécution de scripts post-install non sollicités côté CI.
# (laisser commenté en local pour ne pas casser des installs dev legitimes)
# ignore-scripts=true
