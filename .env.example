# =============================================================================
# OpenPulse — modele de configuration
# =============================================================================
# 1. Copier ce fichier vers .env, a la racine du depot ET a cote du
#    docker-compose de la pile plateforme (le meme fichier sert aux deux).
# 2. Remplir. Aucune valeur ci-dessous n'est utilisable telle quelle.
# 3. Verifier AVANT de demarrer :
#       node scripts/check-env.mjs --profil minimal
#       node scripts/check-env.mjs --profil complet
# 4. Ne jamais commiter le .env rempli.
#
# Conventions :
#   [REQUIS]   absent => l'instance ne demarre pas ou est inutilisable
#   [CONDITIF] requis seulement si le drapeau associe est active
#   [OPTION]   absent => une fonctionnalite est simplement indisponible
#   [SILENCE]  absent => degradation SILENCIEUSE : rien n'echoue, le
#              comportement est faux. A remplir en priorite.
#
# Generer un secret : openssl rand -hex 32
# Generer une paire VAPID : npx web-push generate-vapid-keys
# =============================================================================


# =============================================================================
# 1. IDENTITE DE L'INSTANCE
# =============================================================================

# [REQUIS] Environnement d'execution. Toute valeur differente de "production"
# desactive la minification et laisse les bandeaux de diagnostic visibles.
NODE_ENV=production

# [REQUIS] SHA Git complet (40 hexa) du code construit. Le prebuild refuse de
# demarrer si la valeur n'est ni un SHA de 40 caracteres ni deductible d'un
# .git present. Absent dans une image sans .git => le build echoue.
OPENPULSE_GIT_SHA=

# [OPTION] Horodatage ISO-8601 du build, affiche dans la page de diagnostic.
# Absent => l'heure de build est celle de l'execution du prebuild.
OPENPULSE_BUILD_AT=


# =============================================================================
# 2. FRONTEND — VARIABLES DE BUILD (VITE_*)
# =============================================================================
# ATTENTION : tout VITE_* est inline dans le bundle et donc PUBLIC.
# Ne jamais y placer un secret, une cle de service ou un mot de passe.
# Ces valeurs doivent etre presentes AU MOMENT DU BUILD, pas au demarrage du
# conteneur : les changer apres coup n'a aucun effet sans rebuild.

# [REQUIS] Origine publique de la passerelle API de l'instance.
# Absente => le client pointe vers une chaine vide et aucune requete n'aboutit
# (l'amont repliait ici sur un domaine appartenant a l'editeur : repli supprime).
VITE_SUPABASE_URL=https://api.openpulse.example.org

# [REQUIS] Cle publique (anon) de la passerelle. Doit etre STRICTEMENT egale a
# ANON_KEY de la section 4. Absente => exception levee au chargement du module
# client : ecran blanc, l'application ne demarre pas du tout.
VITE_SUPABASE_PUBLISHABLE_KEY=

# [SILENCE] Nom affiche dans l'onglet du navigateur, dans la metadonnee d'auteur
# et dans l'apercu d'un lien partage. Ces trois valeurs vivent dans index.html et
# sont servies AVANT tout JavaScript : ni l'assistant de premier lancement ni la
# configuration en base ne peuvent les atteindre. C'est la seule part de
# l'identite visuelle qui exige une reconstruction de l'image.
#
# Absente, son marqueur reste LITTERAL dans le HTML produit — le meme piege que
# les variables de politique de securite ci-dessous. La construction s'arrete si
# c'est le cas.
VITE_MARQUE_NOM_PRODUIT=OpenPulse

# --- Politique de securite de contenu ---------------------------------------
# Ces quatre variables sont substituees dans index.html AU MOMENT DU BUILD.
# Elles doivent etre definies MEME VIDES : Vite ne substitue que ce qui existe,
# et une variable absente laisse son marqueur LITTERAL dans le HTML produit.
# La construction reussit alors, l'application se charge, son titre s'affiche
# — et le navigateur refuse ensuite CHAQUE appel vers l'API, parce que
# « connect-src 'self' %VITE_CSP_CONNECT_EXTRA% » n'autorise aucune origine
# reelle. Aucune etape de build ne le signale : verifier apres construction
# avec `node tools/openrelease/verifier-csp-construite.mjs dist`.
#
# Chaque valeur est une liste d'origines explicites separees par des espaces.
# Ni « https: » nu, ni joker de sous-domaine : le contrat de CSP les refuse.
#
# Le Dockerfile fourni ajoute seul l'origine de VITE_SUPABASE_URL et son
# equivalent WebSocket a connect-src. Si vous construisez a la main, ajoutez-les
# vous-meme, sinon l'application ne joindra pas son propre backend.

# [SILENCE] Origines d'images supplementaires.
VITE_CSP_IMG_EXTRA=

# [SILENCE] Origines joignables par requete ou par WebSocket, en plus de celle
# qui sert l'application. Exemple pour une API sur https://api.exemple.org :
#   VITE_CSP_CONNECT_EXTRA=https://api.exemple.org wss://api.exemple.org
VITE_CSP_CONNECT_EXTRA=

# [SILENCE] Origines autorisees a etre integrees en cadre (serveur d'edition de
# documents, tableau de bord tiers).
VITE_CSP_FRAME_EXTRA=

# [SILENCE] Origines de flux audio et video (passerelle de visioconference).
VITE_CSP_MEDIA_EXTRA=

# [OPTION] Backend du module Documents : legacy | azure | hybrid.
# Absent => legacy. En legacy le panneau Drive externe n'est pas rendu et
# l'override d'URL ?backend=azure est volontairement ignore.
VITE_DOCUMENTS_BACKEND=legacy

# [CONDITIF] Base URL du service Drive. Requise des que VITE_DOCUMENTS_BACKEND
# vaut azure ou hybrid. Absente dans ce cas => toute action Drive echoue avec
# "API Drive indisponible", sans indice de configuration cote utilisateur.
VITE_DRIVE_API_URL=

# [OPTION] Cible d'envoi des fichiers : auto | supabase | azure | nextcloud.
# Absent => auto (choix deduit du backend Documents).
VITE_DOCUMENTS_UPLOAD_BACKEND=auto

# [OPTION] Affichage du panneau Assistant IA des documents : on | off.
# Absent => on. Le panneau gere lui-meme un mode "non configure" si le
# fournisseur de modeles n'est pas renseigne cote serveur.
VITE_DOCUMENTS_AI_PANEL=on

# [OPTION] Backend de messagerie : supabase | hybrid | azure.
# Absent => supabase (messagerie historique, aucune supervision externe).
VITE_EMAIL_BACKEND=supabase

# [CONDITIF] Base URL du service Courriel. Requise si VITE_EMAIL_BACKEND vaut
# azure ou hybrid. Absente dans ce cas => le panneau de supervision affiche
# "non configure" et la synchronisation ne demarre jamais.
VITE_EMAIL_AZURE_API_URL=

# [OPTION] Backend du module de discussion interne : supabase | azure | hybrid.
# Absent => supabase.
VITE_PULSE_BACKEND=supabase

# [CONDITIF] Base URL du service de discussion. Requise si VITE_PULSE_BACKEND
# vaut azure ou hybrid. Absente dans ce cas => erreur "non configure" a chaque
# appel du module.
VITE_PULSE_AZURE_API_URL=

# [OPTION] URL WebSocket du temps reel de discussion. Absente => derivee de
# VITE_PULSE_AZURE_API_URL (https->wss, chemin /api/pulse/ws).
VITE_PULSE_AZURE_WS_URL=

# [OPTION] Backend des salles de visioconference : supabase | azure | hybrid.
# Absent => supabase.
VITE_VISIO_BACKEND=supabase

# [OPTION] Backend du pipeline de transcription : supabase | azure | hybrid.
# Absent => supabase.
VITE_TRANSCRIPTION_BACKEND=supabase

# [CONDITIF] Base URL du service Reunions. Requise si VITE_VISIO_BACKEND ou
# VITE_TRANSCRIPTION_BACKEND est different de supabase. Absente dans ce cas =>
# les sondes vers le service sont desactivees sans message.
VITE_MEETINGS_API_BASE_URL=

# [OPTION] DSN de collecte d'erreurs. Absent => la collecte est desactivee en
# silence : aucune erreur de production ne remonte. Choix legitime, mais il
# doit etre explicite.
VITE_SENTRY_DSN=

# [OPTION] Point de collecte OpenTelemetry. Absent => tracage desactive en
# silence.
VITE_OTEL_ENDPOINT=

# [OPTION] Domaine declare aupres du service de mesure d'audience sans cookie.
# Absent => mesure desactivee.
VITE_PLAUSIBLE_DOMAIN=

# [OPTION] Hote de l'API de mesure d'audience auto-hebergee. Absent => l'hote
# public par defaut de la bibliotheque est utilise (sortie reseau externe).
VITE_PLAUSIBLE_API_HOST=

# [SILENCE] Identifiant de site de la mesure d'audience auto-hebergee.
# Le seul fait de renseigner cette variable ACTIVE le traceur. Si vous la
# renseignez sans renseigner VITE_MATOMO_TRACKER_URL, le traceur est actif avec
# une URL vide : aucune mesure n'est collectee et aucune erreur n'apparait.
# Renseignez les deux, ou aucune des deux.
VITE_MATOMO_SITE_ID=

# [SILENCE] URL du traceur d'audience auto-heberge. Voir VITE_MATOMO_SITE_ID.
VITE_MATOMO_TRACKER_URL=

# [OPTION] Bouton d'authentification unique sur l'ecran de connexion :
# true | false. Absent => false, seule la connexion par mot de passe est
# proposee.
VITE_AUTHENTIK_SSO_ENABLED=false

# [OPTION] Autorise l'integration des outils internes dans une iframe de
# l'application : true | false. Absent => false, les entrees de menu
# correspondantes sont masquees.
VITE_INTERNAL_TOOL_EMBED_RUNTIME_ENABLED=false

# [REQUIS pour l'application de bureau] Origine publique de l'application web,
# utilisee par le client de bureau pour ouvrir les modules. Absente => les URL
# construites sont relatives et aucun module ne s'ouvre (l'amont repliait ici
# sur un domaine de l'editeur : repli supprime).
VITE_OPENPULSE_WEB_URL=https://openpulse.example.org


# =============================================================================
# 3. BASE DE DONNEES POSTGRESQL
# =============================================================================
# DEUX CHEMINS D'INSTALLATION, NE PAS LES MELANGER.
#
#   A. Pile complete auto-hebergee : scripts/installer.sh avec
#      docker/docker-compose.openpulse.yml. L'installateur ENGENDRE le .env,
#      base comprise, avec des secrets propres a l'instance. Les variables des
#      sections 3 et 4 marquees [ENGENDRE] ne sont alors PAS a remplir : elles
#      sont ecrites pour vous, et une valeur saisie a la main sera ecrasee.
#
#   B. Base PostgreSQL externe, deja administree. Vous remplissez tout
#      vous-meme, et la composition ci-dessus ne vous sert pas.
#
# Les commentaires precisent, variable par variable, lequel des deux chemins la
# concerne.

# [REQUIS — chemin B] Hote PostgreSQL. Chemin A : la base est le service `db`
# de la composition, joint par son nom de service.
POSTGRES_HOST=postgres.interne.test

# [OPTION] Port PostgreSQL. Declare pour memoire : la pile plateforme fixe le
# port a 5432 dans son compose. Modifier le compose si votre port differe.
POSTGRES_PORT=5432

# [REQUIS] Base applicative principale. Les deux chemins la lisent.
POSTGRES_DB=openpulse

# [REQUIS — chemin B] Compte proprietaire du schema. Chemin A : le compte est
# `postgres`, fixe par l'image.
POSTGRES_USER=openpulse_admin

# [ENGENDRE — chemin A] [REQUIS — chemin B] Mot de passe du compte
# proprietaire.
POSTGRES_PASSWORD=

# [ENGENDRE — chemin A] Mots de passe des roles de service. Chaque service se
# connecte avec le sien : l'API REST par `authenticator`, l'authentification
# par `supabase_auth_admin`, le stockage par `supabase_storage_admin`, le temps
# reel par `supabase_admin`. Aucun ne partage le mot de passe d'un autre, et
# aucun n'est celui du proprietaire.
AUTHENTICATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=
STORAGE_ADMIN_PASSWORD=
REALTIME_ADMIN_PASSWORD=

# [REQUIS — chemin B] URL de connexion de la couche REST, avec le role a
# privileges reduits (PAS le proprietaire). Absente => l'API REST ne demarre
# pas : l'application affiche une coquille vide. Chemin A : construite par la
# composition depuis AUTHENTICATOR_PASSWORD.
POSTGREST_URL=postgresql://openpulse_rest:MOT_DE_PASSE@postgres.interne.test:5432/openpulse?sslmode=require

# [REQUIS pour les services HTTP] URL PostgreSQL injectee dans les quatre
# services HTTP (Drive, Courriel, Reunions, Discussion). Le compose la passe
# telle quelle a chaque conteneur sous le nom DATABASE_URL.
# ATTENTION : si elle est VIDE, chaque service demarre quand meme mais avec un
# depot EN MEMOIRE. Aucune erreur, et toutes les donnees disparaissent au
# redemarrage. C'est la degradation silencieuse la plus couteuse de la pile.
DATABASE_URL=postgresql://openpulse_admin:MOT_DE_PASSE@postgres.interne.test:5432/openpulse?sslmode=require


# =============================================================================
# 4. PILE PLATEFORME AUTO-HEBERGEE
# =============================================================================
# Passerelle, fournisseur d'identite, API REST, temps reel, stockage objet,
# execution des fonctions de bord.

# [ENGENDRE — chemin A] [REQUIS — chemin B] Secret HS256 signant tous les
# jetons de la plateforme. Partage par le fournisseur d'identite, l'API REST,
# le temps reel, le stockage et l'execution des fonctions. Absent => aucune
# connexion possible. 32 octets minimum.
JWT_SECRET=

# [ENGENDRE — chemin A] [REQUIS — chemin B] Jeton public role "anon", signe
# avec JWT_SECRET. Doit etre egal a VITE_SUPABASE_PUBLISHABLE_KEY. Absent =>
# le navigateur est rejete par la passerelle.
ANON_KEY=

# [ENGENDRE — chemin A] [REQUIS — chemin B] Jeton role de service, signe avec
# JWT_SECRET. Contourne toutes les politiques de securite au niveau des lignes :
# ne doit JAMAIS etre expose au navigateur. Absent => toutes les fonctions de
# bord echouent.
SERVICE_ROLE_KEY=

# [ENGENDRE — chemin A] [REQUIS — chemin B] Jeton inclus automatiquement dans
# le lien d'activation affiché à la fin de l'installation. L'administrateur n'a
# rien à recopier. Il reste côté serveur et devient inutilisable après amorçage.
OPENPULSE_INSTALLATION_CODE=

# [ENGENDRE — chemin A] [REQUIS — chemin B] Base de derivation des cles de
# session du temps reel. AU MOINS 64 OCTETS : le service sort au demarrage sur
# une valeur plus courte, avec un message qui ne dit pas laquelle des deux
# valeurs de temps reel est en cause.
REALTIME_SECRET_KEY_BASE=

# [ENGENDRE — chemin A] [REQUIS — chemin B] Cle de chiffrement des metadonnees
# du temps reel. EXACTEMENT 16 OCTETS, meme remarque que ci-dessus.
REALTIME_ENC_KEY=

# [REQUIS] URL externe du fournisseur d'identite, telle que vue par le
# navigateur. Sert aussi d'emetteur (iss) des jetons. Absente => les liens de
# confirmation et de reinitialisation pointent nulle part.
API_EXTERNAL_URL=https://api.openpulse.example.org/auth/v1

# [REQUIS — chemin A] Origine publique de la passerelle, telle que le
# navigateur la voit. Sert d'URL externe au fournisseur d'identite et de base
# aux URL de fichiers. Doit etre egale a VITE_SUPABASE_URL.
PUBLIC_API_URL=https://api.openpulse.example.org

# [REQUIS — chemin A] Origine publique de l'application web.
PUBLIC_URL=https://openpulse.example.org

# [REQUIS] Origine de l'application web, utilisee comme cible de redirection
# apres authentification. Absente => la redirection post-connexion echoue.
SITE_URL=https://openpulse.example.org

# [OPTION] Liste des redirections autorisees, separees par des virgules,
# motifs glob acceptes. Absente => seule SITE_URL est acceptee, ce qui suffit
# tant que vous n'emettez pas d'invitations vers un autre domaine.
AUTH_REDIRECT_ALLOW_LIST=https://openpulse.example.org/**

# [SILENCE] Verification du jeton par la passerelle des fonctions : true|false.
# L'amont fixait "false" en dur dans son compose : toute fonction de bord
# devenait joignable sans jeton, chaque fonction devant se defendre seule.
# Mettre "true" ferme la porte, MAIS les declencheurs planifies qui n'envoient
# qu'un en-tete de secret partage recevront alors un 401 : verifier la section
# 5 (CRON_SECRET) avant de basculer.
VERIFY_JWT=true

# [CONDITIF] Jeu de cles publiques JSON, requis uniquement si vos jetons sont
# signes en ES256/RS256 au lieu de HS256. Absent avec des jetons asymetriques
# => tous les appels sont refuses avec "JWKS not available".
SUPABASE_JWKS=

# --- Stockage objet ---------------------------------------------------------
# Chemin A : le stockage ecrit sur un volume local, il n'y a rien a renseigner
# ici. Les deux variables ci-dessous ne concernent que le chemin B, si vous
# branchez le service de stockage sur un objet compatible S3.

# [CONDITIF — chemin B] Identifiant d'acces au stockage objet compatible S3.
S3_ACCESS_KEY=

# [CONDITIF — chemin B] Secret d'acces au stockage objet compatible S3.
S3_SECRET_KEY=


# =============================================================================
# 5. FONCTIONS DE BORD — SOCLE
# =============================================================================
# IMPORTANT — a lire avant de remplir cette section et les suivantes.
# Le conteneur d'execution des fonctions transmet a chaque fonction l'INTEGRALITE
# de son propre environnement. Le compose de l'amont ne lui declarait que sept
# variables : toutes les autres, ci-dessous, etaient donc absentes a l'execution
# alors qu'elles sont bel et bien lues par le code. Le substitut de compose
# d'OpenPulse charge ce fichier .env dans le conteneur des fonctions ; si vous
# repartez du compose amont, ajoutez-y "env_file: [.env]" sur ce service, sinon
# rien de cette section n'a d'effet.

# [REQUIS] Origine interne de la passerelle, vue depuis le conteneur des
# fonctions. Le compose la fixe sur le nom de service interne ; ne la changez
# que si vous modifiez la topologie reseau.
SUPABASE_URL=http://kong:8000

# [REQUIS] Copie de ANON_KEY pour les fonctions. Absente => les fonctions qui
# valident un jeton utilisateur renvoient 401 pour tout le monde.
SUPABASE_ANON_KEY=

# [REQUIS] Copie de SERVICE_ROLE_KEY pour les fonctions. Absente => 223 des
# 271 fonctions echouent des la creation de leur client.
SUPABASE_SERVICE_ROLE_KEY=

# [SILENCE] Liste des origines autorisees a appeler les fonctions de bord,
# separees par des virgules. Absente, le partage retombe sur les seules origines
# de developpement -- jamais sur le caractere generique : en production, votre
# frontend est refuse par le navigateur, avec pour unique trace un message dans
# la console. A renseigner.
OPENPULSE_ORIGINES_AUTORISEES=https://openpulse.example.org,http://localhost:8080

# [OPTION] Ancien nom de la variable ci-dessus, encore lu en second recours pour
# ne pas casser un deploiement existant. Ne renseignez que l'un des deux.
CORS_ALLOWED_ORIGINS=

# [SILENCE] Origine publique de l'application, utilisee pour fabriquer les
# liens envoyes par courriel (enquetes, transferts, relances). Absente, le code
# repliait sur un domaine de l'editeur : les liens partaient chez un tiers.
# Le repli a ete supprime ; absente, les liens sont desormais relatifs et
# inutilisables. A renseigner.
PUBLIC_APP_URL=https://openpulse.example.org

# [SILENCE] Meme role que PUBLIC_APP_URL pour les notifications de partage de
# document. Meme valeur. Deux noms coexistent dans le code de l'amont : les
# renseigner tous les deux.
APP_URL=https://openpulse.example.org

# [REQUIS] Secret partage authentifiant les appels internes entre fonctions,
# via l'en-tete de secret de fonction. Absent => le chemin d'appel interne ne
# s'authentifie jamais et les 23 fonctions concernees repondent 401 aux
# declencheurs, sans autre trace qu'une ligne de journal.
INTERNAL_FUNCTION_SECRET=

# [SILENCE] Secret des declencheurs planifies. Absent, la comparaison
# a temps constant compare deux chaines vides et renvoie faux : chaque tache
# planifiee repond 401. Les rappels, relances et synchronisations ne partent
# jamais et rien ne le signale dans l'interface.
CRON_SECRET=

# [SILENCE] Second nom du secret de declenchement interne, utilise par deux
# fonctions planifiees. Meme consequence que CRON_SECRET. Renseigner les deux.
INTERNAL_INVOCATION_SECRET=

# [SILENCE] Cle de chiffrement des identifiants de messagerie stockes en base,
# et sel de pseudonymisation du module de conformite. Absente : les 14
# fonctions de messagerie echouent au dechiffrement, et surtout la
# pseudonymisation repliait sur le sel litteral "salt" — pseudonymes
# reproductibles par quiconque connait le code. 32 octets hexa minimum.
EMAIL_ENCRYPTION_KEY=

# [OPTION] Secret HMAC signant les liens de suivi de lecture des courriels.
# Absent => la fonction de suivi renvoie 500 et les liens de suivi sont morts,
# ce qui est le comportement sur : pas d'ouverture de redirection.
EMAIL_TRACKING_HMAC_SECRET=

# [OPTION] Secret protegeant la fonction de validation d'adresse IP. Absent
# avec la liste blanche IP activee => tous les appels sont refuses.
IP_VALIDATOR_SECRET=

# [OPTION] Secret HS256 dedie a l'emission des jetons du point d'entree OAuth
# de l'application. Absent => la fonction repond 500 "service mal configure".
# Un second nom, SUPABASE_JWT_SECRET, est accepte en repli.
# Laisser vide et utiliser JWT_SECRET si vous ne separez pas les usages.
SUPABASE_JWT_SECRET=


# =============================================================================
# 6. FONCTIONS DE BORD — MODELES DE LANGAGE
# =============================================================================
# Un seul fournisseur compatible OpenAI est necessaire. La chaine de repli est
# : modele principal, puis modele economique, puis modele secondaire.

# [OPTION] URL complete du deploiement du modele principal, api-version
# incluse. Absente ET les deux replis absents => toute fonction d'IA leve
# "fournisseur non configure" ; l'erreur est visible cote utilisateur.
# 51 fonctions concernees.
AZURE_OPENAI_ENDPOINT=https://VOTRE-RESSOURCE.openai.azure.com/openai/deployments/VOTRE-DEPLOIEMENT/chat/completions?api-version=2025-01-01-preview

# [OPTION] Cle du modele principal. 52 fonctions concernees.
AZURE_OPENAI_API_KEY=

# [OPTION] Deploiement de repli, sonde par la verification de sante.
AZURE_OPENAI_ENDPOINT_FALLBACK=
AZURE_OPENAI_API_KEY_FALLBACK=

# [OPTION] Deploiement economique, premier repli de la chaine. Absent => la
# chaine passe directement au repli suivant, au prix d'un cout par appel plus
# eleve, sans avertissement.
AZURE_GPT5_MINI_ENDPOINT=
AZURE_GPT5_MINI_API_KEY=

# [OPTION] Deuxieme repli de la chaine.
AZURE_GPT52_ENDPOINT=
AZURE_GPT52_API_KEY=

# [OPTION] Deploiement de vectorisation, utilise par la recherche semantique et
# la base de connaissances. Absent => l'indexation de documents ne produit
# aucun vecteur et la recherche semantique ne renvoie jamais de resultat.
AZURE_EMBEDDING_ENDPOINT=

# [OPTION] Deploiement de transcription audio. Absent => le pipeline de
# comptes rendus de reunion s'arrete apres l'envoi du fichier.
AZURE_TRANSCRIBE_ENDPOINT=
AZURE_TRANSCRIBE_API_KEY=

# [OPTION] Deploiement de generation d'images.
AZURE_IMAGE_ENDPOINT=
AZURE_IMAGE_API_KEY=
AZURE_IMAGE_DEPLOYMENT=

# [OPTION] Cle d'un fournisseur compatible OpenAI utilisee par la seule
# fonction de transcription directe. Absente => cette fonction repond 500.
OPENAI_API_KEY=

# [OPTION] Cle d'un moteur de recherche web pour l'assistant. Absente =>
# l'outil de recherche web de l'assistant est indisponible.
BRAVE_SEARCH_API_KEY=


# =============================================================================
# 7. FONCTIONS DE BORD — COURRIEL SORTANT ET NOTIFICATIONS
# =============================================================================

# [SILENCE] Cle du service d'envoi de courriel transactionnel. Absente, onze
# fonctions n'echouent PAS : elles journalisent "envoi ignore" et renvoient
# success:true. L'interface confirme un envoi qui n'a jamais eu lieu. C'est le
# pire cas de la configuration : a renseigner en priorite, ou desactiver
# explicitement les fonctionnalites de notification par courriel.
RESEND_API_KEY=

# [OPTION] Cle publique VAPID des notifications navigateur. Absente => la
# fonction d'envoi leve "cles VAPID non configurees" (erreur visible).
VAPID_PUBLIC_KEY=

# [OPTION] Cle privee VAPID. Meme consequence.
VAPID_PRIVATE_KEY=

# [SILENCE] Contact VAPID, au format mailto:. Deux consequences si absent :
# l'amont repliait sur une adresse de l'editeur (repli supprime), et cette
# variable sert AUSSI de sel au hachage des adresses IP dans la fonction de
# telechargement de transfert, ou le repli litteral "salt" rend le hachage
# reversible. A renseigner.
VAPID_SUBJECT=mailto:admin@example.org

# [OPTION] URL du serveur de messagerie JMAP interne, pour la migration et la
# synchronisation JMAP. Absente => repli sur le nom de service interne
# "http://stalwart:8080", correct dans le compose fourni.
STALWART_URL=http://stalwart:8080

# [CONDITIF] Mot de passe d'administration du serveur de messagerie interne,
# requis si vous activez ce service dans le compose.
STALWART_ADMIN_PASSWORD=


# =============================================================================
# 8. FONCTIONS DE BORD — DOCUMENTS ET BUREAUTIQUE
# =============================================================================

# [OPTION] URL du serveur de fichiers WebDAV. Absente => les quatre fonctions
# de fichiers repondent "non configure" et l'onglet correspondant est vide.
NEXTCLOUD_URL=https://fichiers.example.org

# [OPTION] Compte de service du serveur de fichiers.
NEXTCLOUD_USERNAME=

# [OPTION] Mot de passe d'application du compte de service. Ne jamais utiliser
# le mot de passe principal du compte.
NEXTCLOUD_APP_PASSWORD=

# [OPTION] Dossier racine des documents. Absent => la racine du compte est
# utilisee, ce qui melange les documents applicatifs et personnels.
NEXTCLOUD_BASE_FOLDER=/OpenPulse

# [OPTION] URL du serveur d'edition collaborative de documents. Absente =>
# l'ouverture d'un document en edition echoue.
ONLYOFFICE_DOCUMENT_SERVER_URL=https://bureautique.example.org

# [OPTION] Secret JWT partage avec le serveur d'edition. Absent => le serveur
# d'edition refuse les jetons de l'application.
ONLYOFFICE_JWT_SECRET=

# [OPTION] URL de l'espace documentaire hebergé, si utilise.
ONLYOFFICE_DOCSPACE_URL=

# [OPTION] Cle d'API de l'espace documentaire.
ONLYOFFICE_API_KEY=


# =============================================================================
# 9. FONCTIONS DE BORD — SIGNATURE ELECTRONIQUE
# =============================================================================

# [OPTION] Cle d'API du service de signature. Absente => les quatre fonctions
# de signature (demande, rappel, annulation, envoi) repondent en erreur.
DOCUSEAL_API_KEY=

# [OPTION] Secret verifiant l'authenticite des rappels du service de signature.
# Absent => les rappels sont acceptes sans verification : n'importe qui peut
# declarer un document signe. A renseigner si la signature est utilisee.
DOCUSEAL_WEBHOOK_SECRET=


# =============================================================================
# 10. FONCTIONS DE BORD — BANQUE ET COMPTABILITE
# =============================================================================

# [OPTION] Cle d'API bancaire pour la synchronisation des operations. Absente
# => le module tresorerie reste vide.
QONTO_API_KEY=

# [OPTION] Identifiant d'organisation bancaire.
QONTO_ORGANIZATION_ID=

# [OPTION] Identifiants du client OAuth bancaire, si vous utilisez le
# raccordement delegue plutot que la cle d'API.
QONTO_CLIENT_ID=
QONTO_CLIENT_SECRET=
QONTO_REDIRECT_URI=https://openpulse.example.org/parametres/banque/retour

# [OPTION] Cle de chiffrement des jetons bancaires stockes en base. Absente =>
# les jetons sont conserves en clair.
QONTO_ENCRYPTION_KEY=

# [OPTION] Secret verifiant les rappels bancaires. Absent => les rappels sont
# acceptes sans verification.
QONTO_WEBHOOK_SECRET=

# [OPTION] Identifiants du portail de facturation publique, pour la
# transmission des factures au secteur public. Absents => la transmission
# echoue avec une erreur visible.
CHORUS_PRO_CLIENT_ID=
CHORUS_PRO_CLIENT_SECRET=
CHORUS_PRO_LOGIN=
CHORUS_PRO_PASSWORD=


# =============================================================================
# 11. FONCTIONS DE BORD — IDENTITES TIERCES ET RESEAUX SOCIAUX
# =============================================================================
# Toutes optionnelles. Absentes, la connexion du compte correspondant echoue
# a l'etape d'autorisation, avec un message explicite.

# [OPTION] Client OAuth pour l'agenda et la visioconference externes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# [OPTION] Jeton de rafraichissement d'un compte de service, utilise par la
# creation automatique de liens de reunion.
GOOGLE_REFRESH_TOKEN=

# [SILENCE] Cle dediee au chiffrement des jetons OAuth externes. Absente, le
# code repliait sur la cle de role de service comme matiere de chiffrement,
# pour le DECHIFFREMENT seulement : les jetons existants restent lisibles, mais
# tout nouveau chiffrement leve une erreur. Separer les cles : 32 octets hexa.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# [OPTION] Secret signant l'etat OAuth, protection contre la falsification de
# requete inter-site pendant l'autorisation. Absent => l'echange OAuth est
# vulnerable au rejeu d'etat.
OAUTH_STATE_SECRET=

# [OPTION] Applications de publication sur les reseaux sociaux.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=


# =============================================================================
# 12. FONCTIONS DE BORD — MESSAGERIE INSTANTANEE ET TELEPHONIE
# =============================================================================
# Canaux de sortie de l'assistant multi-canal. Absents, le canal concerne est
# ignore silencieusement : l'assistant se rabat sur les canaux configures.

SLACK_WEBHOOK_URL=
TEAMS_WEBHOOK_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=


# =============================================================================
# 13. FONCTIONS DE BORD — API SORTANTE VERS VOS PROPRES PRODUITS
# =============================================================================
# A remplir seulement si vous branchez un produit tiers sur l'API de
# l'instance. Sinon, laisser vide : les fonctions concernees refusent
# proprement l'appel.

# [OPTION] Secret HS256 des jetons d'authentification unique emis vers un
# produit partenaire. Absent => la fonction leve "non configure".
PLATFORM_SSO_JWT_SECRET=

# [OPTION] Base URL du produit partenaire recevant les provisions de clients.
PRODUCT_API_URL=https://produit.example.org

# [OPTION] Secret HMAC signant les rappels envoyes au produit partenaire.
PRODUCT_WEBHOOK_SECRET=


# =============================================================================
# 14. SERVICES HTTP — DRIVE
# =============================================================================

# [SILENCE] Environnement du service : dev | staging | prod.
# La validation de configuration ne s'execute QUE si la valeur est "prod".
# Toute autre valeur laisse le service demarrer avec l'authentification
# desactivee, un stockage factice et un depot en memoire, sans avertissement.
# Mettre "prod" sur toute instance reelle.
DRIVE_ENV=prod

# [REQUIS en prod] Mode d'authentification : disabled | jwt. "disabled" ouvre
# l'API a tous. La validation refuse de demarrer si la valeur n'est pas "jwt"
# alors que DRIVE_ENV=prod.
DRIVE_AUTH_MODE=jwt

# [REQUIS en prod] Exiger une session a second facteur pour ouvrir le Drive :
# true | false. Mettre false n'a de sens que si aucun compte n'a de second
# facteur — sinon plus personne ne peut ouvrir le Drive.
DRIVE_REQUIRE_MFA=true

# [REQUIS en prod] Secret HS256 propre au Drive, distinct de JWT_SECRET.
# 32 caracteres minimum, sinon la validation refuse de demarrer.
DRIVE_JWT_SECRET=

# [OPTION] Emetteur et audience des jetons Drive.
DRIVE_JWT_ISSUER=openpulse-drive
DRIVE_JWT_AUDIENCE=openpulse-drive-api

# [OPTION] Duree de vie du jeton d'acces, en secondes. Doit rester entre 900 et
# 86400, sinon la validation refuse de demarrer.
DRIVE_JWT_TTL_SECONDS=3600

# [OPTION] Duree de vie du jeton de renouvellement du client de bureau, en
# secondes. Doit rester entre 1 et 90 jours.
DESKTOP_REFRESH_TTL_SECONDS=2592000

# [REQUIS en prod] Secret signant les jetons d'envoi de fichier. 32 caracteres
# minimum et different de la valeur de developpement, sinon refus de demarrer.
DRIVE_APP_SECRET=

# [REQUIS en prod] Chaine de connexion au stockage objet du Drive. Vide => URL
# factices : les envois semblent reussir et aucun octet n'est ecrit.
# Variante en deux morceaux : AZURE_STORAGE_ACCOUNT + AZURE_STORAGE_ACCOUNT_KEY
# ci-dessous. L'un ou l'autre suffit.
AZURE_STORAGE_CONNECTION_STRING=

# [OPTION] Nom du compte de stockage vu par les services HTTP.
AZURE_STORAGE_ACCOUNT=

# [OPTION] Cle du compte de stockage, seconde moitie de la variante en deux
# morceaux. Lue par les services Drive et Reunions : c'est la MEME valeur pour
# les deux, ne pas la dedoubler.
AZURE_STORAGE_ACCOUNT_KEY=

# [OPTION] Conteneurs de stockage du Drive.
DRIVE_BLOB_CONTAINER_FILES=openpulse-drive-files
DRIVE_BLOB_CONTAINER_VERSIONS=openpulse-drive-versions

# [OPTION] Duree de vie des URL signees d'acces aux fichiers, en minutes.
DRIVE_SAS_TTL_MINUTES=15

# [REQUIS] Origines autorisees a appeler le Drive, separees par des virgules.
# Absente => repli sur http://localhost:5173 seul : votre frontend est refuse.
DRIVE_CORS_ORIGINS=https://openpulse.example.org


# =============================================================================
# 15. SERVICES HTTP — COURRIEL, REUNIONS, DISCUSSION
# =============================================================================
# Meme structure que le Drive. Pour chacun, l'environnement conditionne la
# validation : toute valeur autre que prod laisse le service demarrer sans
# authentification et sans persistance.

# --- Courriel ---
EMAIL_ENV=prod
# [REQUIS en prod] disabled | jwt. La production exige jwt ET DATABASE_URL.
EMAIL_AUTH_MODE=jwt
# [REQUIS en mode jwt] Les trois sont exiges ensemble ; il en manque un et le
# service refuse de demarrer.
EMAIL_JWT_SECRET=
EMAIL_JWT_ISSUER=openpulse
EMAIL_JWT_AUDIENCE=openpulse-email-api
# [REQUIS] Origines autorisees, separees par des virgules.
EMAIL_CORS_ORIGINS=https://openpulse.example.org

# --- Reunions ---
MEETINGS_ENV=prod
# [REQUIS en prod] disabled | jwt.
MEETINGS_AUTH_MODE=jwt
MEETINGS_JWT_SECRET=
MEETINGS_JWT_ISSUER=openpulse
MEETINGS_JWT_AUDIENCE=openpulse-meetings-api
# [OPTION] Conteneur des enregistrements et duree de vie des URL d'envoi.
MEETINGS_BLOB_CONTAINER_RECORDINGS=openpulse-meetings-recordings
MEETINGS_SAS_TTL_MINUTES=30
# [REQUIS] Origines autorisees.
MEETINGS_CORS_ORIGINS=https://openpulse.example.org

# --- Discussion interne ---
PULSE_ENV=prod
# [REQUIS en prod] disabled | jwt.
PULSE_AUTH_MODE=jwt
# [REQUIS en mode jwt] Le service refuse explicitement les valeurs de
# remplissage du type CHANGE_ME ou dev-only-secret en production.
PULSE_JWT_SECRET=
PULSE_JWT_ISSUER=openpulse
PULSE_JWT_AUDIENCE=openpulse-pulse-api
# [REQUIS] Origines autorisees.
PULSE_CORS_ORIGINS=https://openpulse.example.org


# =============================================================================
# 16. INTEGRATION CONTINUE ET TESTS — hors instance
# =============================================================================
# Ces variables ne servent jamais a une instance en service. Ne les definissez
# pas sur un serveur de production. Elles sont listees pour que personne ne les
# cherche ailleurs : voir docs/CONFIGURATION.md section 8.
#
# E2E_BASE_URL, E2E_EMAIL, E2E_PASSWORD, E2E_PASSWORD_DEFAULT,
# E2E_ADMIN_EMAIL, E2E_ADMIN_PASSWORD, E2E_ADMIN_TOTP_SECRET, E2E_SKIP_SETUP,
# PLAYWRIGHT_BASE_URL, TEST_ACCOUNTS_PASSWORD, RUN_CRUD_E2E, RUN_RBAC_MATRIX,
# RUN_VISUAL, RUN_EDGE_IMPORT_TEST, EDGE_TEST_SCENARIO, X_API_KEY_TEST,
# WEBDAV_TEST_TEMP_KEY, DRIVE_TEST_POSTGRES_URL, VITEST_MAX_FORKS,
# VITEST_FORK_HEAP_MB, STRYKER_MODULE, CAP_SERVER_URL, EXPORT_DIR,
# DB_HOST, DB_NAME, DB_USER, DB_PASSWORD, MINIO_ACCESS_KEY, MINIO_SECRET_KEY,
# AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, SUPABASE_SERVICE_KEY, CI.
# =============================================================================

# Nom de l'instance : prefixe des conteneurs, reseaux et volumes Docker.
# A changer UNIQUEMENT si vous faites tourner plusieurs instances sur la meme
# machine — une recette et une production, par exemple. Deux instances qui
# partagent ce nom partagent aussi leur base.
OPENPULSE_INSTANCE=openpulse

# [OPTION] Synthese vocale de l'assistant (fonction jarvis-tts). Sans ces deux
# valeurs, l'assistant reste muet et l'interface retombe sur du texte : la
# conference vocale est degradee, pas cassee. Elles vont par paire.
AZURE_TTS_ENDPOINT=
AZURE_TTS_API_KEY=
