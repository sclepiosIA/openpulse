# =====================================================================
# Image du frontend OpenPulse.
#
# Construction en deux etapes : la premiere compile, la seconde ne contient que
# le resultat et un serveur statique. L'image finale ne porte donc ni le code
# source, ni les dependances de developpement, ni les secrets de construction.
#
# ATTENTION AUX VARIABLES : celles prefixees VITE_ sont incorporees dans le
# bundle AU MOMENT DE LA CONSTRUCTION. Elles sont donc lisibles par tout
# visiteur. N'y placer que ce qui est public : l'URL de l'API et la cle publique.
# Jamais la cle de service, jamais un secret de signature.
# =====================================================================

# --- construction -----------------------------------------------------
FROM node:20-alpine AS construction

WORKDIR /app

# Les dependances d'abord : cette couche ne change que si le verrou change.
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .

# Configuration publique, injectee a la construction.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ARG VITE_BRAND_NAME=OpenPulse

# Nom de produit substitue dans index.html : titre d'onglet, auteur du document
# et titre d'apercu de lien. Ces trois valeurs sont servies AVANT tout
# JavaScript — un robot d'indexation ou un apercu de lien partage ne verra
# jamais ce que l'application applique ensuite. La valeur par defaut evite un
# marqueur litteral dans le HTML, que verifier-csp-construite.mjs refuse.
ARG VITE_MARQUE_NOM_PRODUIT=OpenPulse
# Pas de valeur par defaut : « inconnu » donnait l'illusion d'un repli, alors
# que le script d'empreinte exige un SHA de 40 caracteres et faisait echouer la
# construction. Mieux vaut exiger franchement que promettre a faux.
ARG OPENPULSE_GIT_SHA

# Origines supplementaires de la politique de securite de contenu. Vides par
# defaut, et c'est le bon defaut : la CSP n'autorise alors que l'origine qui
# sert l'application, plus celle de l'API, deduite plus bas. A ne renseigner
# que pour un service tiers reellement joint par le navigateur -- passerelle de
# visioconference, serveur d'edition de documents.
#
# Elles doivent etre definies MEME VIDES : Vite ne substitue dans index.html
# que ce qui existe, et une variable absente y laisse son marqueur litteral.
ARG VITE_CSP_IMG_EXTRA=
ARG VITE_CSP_CONNECT_EXTRA=
ARG VITE_CSP_FRAME_EXTRA=
ARG VITE_CSP_MEDIA_EXTRA=

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_PUBLISHABLE_KEY=$VITE_SUPABASE_PUBLISHABLE_KEY \
    VITE_BRAND_NAME=$VITE_BRAND_NAME \
    VITE_MARQUE_NOM_PRODUIT=$VITE_MARQUE_NOM_PRODUIT \
    OPENPULSE_GIT_SHA=$OPENPULSE_GIT_SHA \
    VITE_CSP_IMG_EXTRA=$VITE_CSP_IMG_EXTRA \
    VITE_CSP_CONNECT_EXTRA=$VITE_CSP_CONNECT_EXTRA \
    VITE_CSP_FRAME_EXTRA=$VITE_CSP_FRAME_EXTRA \
    VITE_CSP_MEDIA_EXTRA=$VITE_CSP_MEDIA_EXTRA \
    NODE_ENV=production

# Echec explicite plutot que bundle silencieusement inutilisable : sans ces deux
# valeurs, l'application se charge et n'atteint jamais son API.
RUN test -n "$VITE_SUPABASE_URL" || (echo "VITE_SUPABASE_URL est requise a la construction" >&2; exit 1) && \
    test -n "$VITE_SUPABASE_PUBLISHABLE_KEY" || (echo "VITE_SUPABASE_PUBLISHABLE_KEY est requise a la construction" >&2; exit 1)

# Le projet est volumineux : la construction depasse le tas par defaut de Node.
ENV NODE_OPTIONS=--max-old-space-size=8192

# L'origine de l'API doit figurer dans connect-src, sinon le navigateur refuse
# chaque appel de l'application vers son propre backend. La deduire de
# VITE_SUPABASE_URL evite de la saisir deux fois : une duplication manuelle
# qu'on oublie une fois sur deux, pour un symptome qui ne ressemble pas a sa
# cause -- l'application se charge, s'affiche, et reste vide.
#
# Construction et verification dans la meme couche : la variable derivee
# n'existe que le temps de la commande, et un marqueur non substitue arrete
# ici plutot que de partir en production.
RUN ORIGINES_API="$(node -e 'const u=new URL(process.env.VITE_SUPABASE_URL); const ws=u.protocol==="https:"?"wss:":"ws:"; process.stdout.write(u.origin+" "+ws+"//"+u.host)')" && \
    export VITE_CSP_CONNECT_EXTRA="${VITE_CSP_CONNECT_EXTRA:+$VITE_CSP_CONNECT_EXTRA }$ORIGINES_API" && \
    echo "connect-src supplementaire : $VITE_CSP_CONNECT_EXTRA" && \
    npm run build && \
    node tools/openrelease/verifier-csp-construite.mjs dist

# --- service ----------------------------------------------------------
FROM nginx:1.31-alpine AS service

# En-tetes de securite, dans un fragment inclus explicitement partout.
#
# POURQUOI UN FRAGMENT, ET PAS DES DIRECTIVES AU NIVEAU DU SERVEUR
# nginx n'herite les `add_header` du niveau superieur QUE si le niveau courant
# n'en declare aucun. Les deux `location` ci-dessous posent leur propre
# `Cache-Control` : des en-tetes de securite declares seulement au niveau
# `server` y seraient donc silencieusement perdus — precisement sur index.html,
# la page qui porte l'application. Le fragment est donc inclus dans chaque bloc
# qui declare un `add_header`.
#
# `frame-ancestors` ne peut PAS etre servi par une balise meta : sans cet
# en-tete, l'application etait encadrable par n'importe quel site.
RUN printf '%s\n' \
  'add_header Content-Security-Policy "default-src '"'"'self'"'"'; script-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; style-src '"'"'self'"'"' '"'"'unsafe-inline'"'"'; img-src '"'"'self'"'"' data: blob:; font-src '"'"'self'"'"' data:; connect-src '"'"'self'"'"' https: wss:; frame-src '"'"'self'"'"'; media-src '"'"'self'"'"' blob:; worker-src '"'"'self'"'"' blob:; manifest-src '"'"'self'"'"'; object-src '"'"'none'"'"'; base-uri '"'"'self'"'"'; form-action '"'"'self'"'"'; frame-ancestors '"'"'self'"'"'" always;' \
  'add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;' \
  'add_header X-Frame-Options "SAMEORIGIN" always;' \
  'add_header X-Content-Type-Options "nosniff" always;' \
  'add_header Referrer-Policy "strict-origin-when-cross-origin" always;' \
  'add_header Permissions-Policy "geolocation=(self), microphone=(self), camera=(self), payment=(), usb=(), magnetometer=(), gyroscope=()" always;' \
  > /etc/nginx/snippets-securite.conf

# Application a page unique : toute route inconnue rend index.html, sinon un
# rechargement sur une route profonde renvoie 404.
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  server_name _;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  include /etc/nginx/snippets-securite.conf;' \
  '  # Les fichiers empreintes sont immuables ; index.html ne doit jamais etre' \
  '  # mis en cache, sinon un deploiement reste invisible pour les visiteurs.' \
  '  location /assets/ { expires 1y; add_header Cache-Control "public, immutable"; include /etc/nginx/snippets-securite.conf; }' \
  '  location = /index.html { add_header Cache-Control "no-cache, must-revalidate"; include /etc/nginx/snippets-securite.conf; }' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '  location = /healthz { return 200 "ok\\n"; add_header Content-Type text/plain; include /etc/nginx/snippets-securite.conf; }' \
  '}' > /etc/nginx/conf.d/default.conf

COPY --from=construction /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null 2>&1 || exit 1
