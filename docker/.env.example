# ============================================
# Variables d'Environnement - OpenPulse
# Configuration Self-Hosted avec Supabase On-Premise
# Copier ce fichier vers .env et remplir les valeurs
# ============================================

# ============================================
# Application
# ============================================
NODE_ENV=production
APP_URL=https://gestion.exploitant.example.org

# ============================================
# Supabase On-Premise (Self-Hosted)
# ============================================
# URL de votre instance Supabase self-hosted (Kong API Gateway)
# Format: http://<VOTRE_IP_PUBLIQUE>:8000
SUPABASE_URL=http://VOTRE_IP_PUBLIQUE:8000
VITE_SUPABASE_URL=http://VOTRE_IP_PUBLIQUE:8000

# Clé anonyme (anon key) générée par Supabase self-hosted
# Récupérez-la depuis: docker logs supabase-kong ou votre .env Supabase
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY

# Clé service role (pour les opérations admin côté serveur)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# JWT Secret utilisé par Supabase (doit correspondre à celui de votre config Supabase)
# Générer avec: openssl rand -base64 32
SUPABASE_JWT_SECRET=votre-jwt-secret-supabase

# ============================================
# Base de données PostgreSQL (Supabase On-Premise)
# ============================================
# ⚠️ SÉCURITÉ: Ne jamais utiliser de mots de passe par défaut !
# Générer avec: openssl rand -base64 24

SUPABASE_HOST=VOTRE_IP_PUBLIQUE
SUPABASE_PORT=8000

POSTGRES_HOST=VOTRE_IP_PUBLIQUE
POSTGRES_PORT=5432
POSTGRES_USER=postgres
# ⚠️ REMPLACER PAR UN MOT DE PASSE GÉNÉRÉ: openssl rand -base64 24
POSTGRES_PASSWORD=GENERER_AVEC_OPENSSL_RAND
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:VOTRE_MOT_DE_PASSE@VOTRE_IP_PUBLIQUE:5432/postgres

# ============================================
# JWT Authentication (Application)
# ============================================
# Générer avec: openssl rand -base64 32
JWT_SECRET=GENERER_UN_SECRET_DE_256_BITS_MINIMUM
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# ============================================
# Azure OpenAI (GPT-5)
# ============================================
# URL complète du déploiement Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://votre-instance.openai.azure.com/openai/deployments/gpt-5/chat/completions?api-version=2025-01-01-preview
AZURE_OPENAI_API_KEY=votre-cle-api-azure

# ============================================
# Email (OVH SMTP/IMAP)
# ============================================
SMTP_HOST=smtp.example.org
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@exploitant.example.org
SMTP_PASS=votre-mot-de-passe-email

IMAP_HOST=smtp.example.org
IMAP_PORT=993

# Email de support partagé
SUPPORT_EMAIL=support@exploitant.example.org
SUPPORT_EMAIL_PASSWORD=votre-mot-de-passe-support

# ============================================
# Stockage S3 Compatible (MinIO, OVH Object Storage, AWS S3)
# ============================================
S3_ENDPOINT=https://s3.example.org
S3_ACCESS_KEY=votre-access-key
S3_SECRET_KEY=votre-secret-key
S3_BUCKET=marque-storage
S3_REGION=gra

# ============================================
# Push Notifications (VAPID)
# ============================================
# Clés VAPID pour Web Push
# Générer avec: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:contact@exploitant.example.org

# ============================================
# Sécurité
# ============================================
# Clé de chiffrement pour les mots de passe email (32 caractères)
# Générer avec: openssl rand -hex 16
ENCRYPTION_KEY=GENERER_UNE_CLE_DE_32_CARACTERES

# CORS
CORS_ORIGIN=https://gestion.exploitant.example.org

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# Redis (Cache et Sessions)
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# ============================================
# Monitoring (Optionnel)
# ============================================
# SENTRY_DSN=https://xxx@sentry.io/xxx

# Grafana (pour docker-compose.monitoring.yml)
# Générer avec: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=GENERER_AVEC_OPENSSL_RAND

# Sentry On-Premise (si utilisé)
# Générer avec: python3 -c "import secrets; print(secrets.token_hex(32))"
SENTRY_SECRET_KEY=GENERER_AVEC_PYTHON_SECRETS
SENTRY_DB_USER=sentry
SENTRY_DB_NAME=sentry
SENTRY_DB_PASSWORD=GENERER_AVEC_OPENSSL_RAND

# ============================================
# Développement uniquement
# ============================================
# DEBUG=true
# LOG_LEVEL=debug

# ============================================
# INSTRUCTIONS DE GÉNÉRATION SÉCURISÉE
# ============================================
# 
# Exécuter ces commandes pour générer des valeurs sécurisées:
#
# POSTGRES_PASSWORD=$(openssl rand -base64 24)
# JWT_SECRET=$(openssl rand -base64 48)
# ENCRYPTION_KEY=$(openssl rand -hex 16)
# GRAFANA_ADMIN_PASSWORD=$(openssl rand -base64 24)
# SENTRY_SECRET_KEY=$(python3 -c "import secrets; print(secrets.token_hex(32))")
# SENTRY_DB_PASSWORD=$(openssl rand -base64 24)
#
# ⚠️ IMPORTANT: Sauvegarder ces credentials de façon sécurisée !
# ============================================
