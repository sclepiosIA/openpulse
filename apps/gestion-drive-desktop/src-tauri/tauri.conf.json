{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestion Drive",
  "version": "0.1.11",
  "identifier": "com.marqueia.gestion-drive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gestion Desktop",
        "label": "main",
        "width": 1080,
        "height": 700,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; frame-src https://espace.exploitant.example.org https://gestion.exploitant.example.org https://openpulse-gestion-web.openpulse.example.org"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCQkM1QjZBOUE3RUNFRDUKUldUVnpuNmFhbHU4Uy9RUnVaVGRPYjJkZmlnNWphVnEyUlUycTJtQXY3a0Y2SWltRnF2c0dVNWYK",
      "endpoints": [
        "https://openpulse-gestion-web.openpulse.example.org/desktop-downloads/latest.json"
      ]
    }
  }
}
