# --- openpulse-meetings-api — variables d'environnement (placeholders, JAMAIS de vrais secrets ici) ---

# Environnement: dev | staging | prod
MEETINGS_ENV=dev

# Base PostgreSQL Azure (tables meeting_*_azure / transcription_*_azure,
# cf. azure/meetings/migrations/0001_meetings_azure.sql).
# Si vide => store in-memory (dev/tests uniquement).
DATABASE_URL=

# Stockage Azure Blob. Si vide => URLs SAS stub (dev/tests, aucun upload réel).
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=

# Container Blob des enregistrements
MEETINGS_BLOB_CONTAINER_RECORDINGS=gestion-meetings-recordings

# Durée de vie des SAS d'upload (minutes)
MEETINGS_SAS_TTL_MINUTES=30

# Auth: disabled (dev) | jwt (valide le JWT Gestion/Supabase HS256)
MEETINGS_AUTH_MODE=disabled
MEETINGS_JWT_SECRET=CHANGE_ME_JWT_SECRET

# CORS (origines séparées par des virgules)
MEETINGS_CORS_ORIGINS=http://localhost:5173,https://gestion.exploitant.example.org
