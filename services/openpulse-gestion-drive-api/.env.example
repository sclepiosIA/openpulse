# --- Gestion Drive API — variables d'environnement (placeholders, JAMAIS de vrais secrets ici) ---

# Environnement: dev | staging | prod
DRIVE_ENV=dev

# Base PostgreSQL Azure. Si vide => repository in-memory (dev/tests uniquement).
# Exemple: postgresql://drive_user:CHANGE_ME@db.openpulse.example.org:5432/gestion?sslmode=require
DATABASE_URL=

# Stockage Azure Blob. Si vide => URLs stub (dev/tests uniquement, aucun upload réel).
# Option 1: connection string complète
AZURE_STORAGE_CONNECTION_STRING=
# Option 2: compte + clé (utilisés si pas de connection string)
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_ACCOUNT_KEY=

# Containers Blob (créés côté Azure, voir README)
DRIVE_BLOB_CONTAINER_FILES=gestion-drive-files
DRIVE_BLOB_CONTAINER_VERSIONS=gestion-drive-versions

# Durée de vie des SAS (minutes)
DRIVE_SAS_TTL_MINUTES=15

# Auth: disabled (dev) | jwt (valide uniquement le JWT Drive dédié)
DRIVE_AUTH_MODE=disabled
# Secret HS256 propre à l'API Drive (ne pas partager avec le provider Gestion)
DRIVE_JWT_SECRET=CHANGE_ME_JWT_SECRET
# JWT d'accès court + grant opaque rotatif conservé haché côté serveur.
DRIVE_JWT_TTL_SECONDS=3600
DESKTOP_REFRESH_TTL_SECONDS=2592000

# Secret applicatif pour signer les upload tokens (obligatoire en prod)
DRIVE_APP_SECRET=CHANGE_ME_APP_SECRET

# CORS (origines séparées par des virgules)
DRIVE_CORS_ORIGINS=http://localhost:5173,https://gestion.exploitant.example.org
