# --- openpulse-pulse-api — variables d'environnement (placeholders, JAMAIS de vrais secrets ici) ---

# Environnement: dev | staging | prod
PULSE_ENV=dev

# Base PostgreSQL Azure (tables pulse_*_azure,
# cf. azure/pulse/migrations/001_pulse_azure_schema.sql).
# Si vide => store in-memory (dev/tests uniquement).
DATABASE_URL=

# Auth: disabled (dev uniquement) | jwt (obligatoire en production).
# Les JWT doivent être HS256, exp/sub/aud valides et dédiés à Pulse.
PULSE_AUTH_MODE=disabled
PULSE_JWT_SECRET=CHANGE_ME_JWT_SECRET
PULSE_JWT_AUDIENCE=openpulse-pulse-api

# CORS (origines séparées par des virgules)
PULSE_CORS_ORIGINS=http://localhost:5173,https://gestion.exploitant.example.org
