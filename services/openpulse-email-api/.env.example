# --- openpulse-email-api — variables d'environnement (placeholders, JAMAIS de vrais secrets ici) ---

# Environnement: dev | staging | prod
EMAIL_ENV=dev

# Base PostgreSQL Azure (tables email_*_azure,
# cf. scripts/migration/azure/001_email_smart_inbox_lot1.sql).
# Si vide => store in-memory (dev/tests uniquement).
DATABASE_URL=

# Auth: disabled (dev) | jwt (valide le JWT Gestion/Supabase HS256)
EMAIL_AUTH_MODE=disabled
EMAIL_JWT_SECRET=CHANGE_ME_JWT_SECRET

# CORS (origines séparées par des virgules)
EMAIL_CORS_ORIGINS=http://localhost:5173,https://gestion.exploitant.example.org
