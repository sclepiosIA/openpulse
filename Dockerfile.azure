FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
COPY dist /usr/share/nginx/html
# Les artefacts Desktop peuvent provenir de runners qui conservent des modes 0600.
# Normaliser explicitement afin que les workers Nginx non-root puissent servir
# le manifeste OTA et les installateurs.
RUN chmod -R a+rX /usr/share/nginx/html/desktop-downloads
COPY nginx.azure.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
